# Checking for Relationships/Correlation
library(dplyr)
library(ggplot2)
colnames(cor_matrix)<-gsub(" ", " ", colnames(cor_matrix))
library(ggplot2)
library(plotly)
library(dplyr)
cleaned_data<-green_ai_datacenter
print("cleaned_data successfully created!")
library(dplyr)
colnames(cor_matrix)<-gsub(" ", " ", colnames(cor_matrix))
colnames(cor_matrix)<-gsub(" ", " ", colnames(cor_matrix))
colnames(cor_matrix)<-gsub(" ", " ", colnames(cor_matrix))
cor_matrix<-cor(green_ai_datacenter)
colnames(cor_matrix)<-gsub(" ", " ", colnames(cor_matrix))
numeric_data<-select_if(green_ai_datacenter, is.numeric)
cor_matrix<-cor(numeric_data)
colnames(cor_matrix)<-gsub(" ", " ", colnames(cor_matrix))
corrplot::corrplot(cor_matrix,
method = "color",
type ="upper",# Only show the top half to reduce clutter
tl.pos = "n", # Hides the overlapping text labels
diag = FALSE,
tl.col = "black", # Changes text label color to clean black
tl.srt = 45, # Rotate text labels by 45 degrees
tl.cex = 0.45, # Shrinks the text size so names don't overlap
mar = c(0, 0, 2, 0), # Adds margins so top labels aren't cut off
title = "Telemetry Metrics Correlation Matrix")
