library(dplyr)
datacenter_summary<-cleaned_data %>%
group_by(datacenter_region) %>%
summarise(
mean_cpu = mean(cpu_utilization, na.rm = TRUE),
median_cpu = median(cpu_utilization, na.rm = TRUE),
sd_cpu = sd(cpu_utilization, na.rm = TRUE)
)
print(datacenter_summary)
